{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nomnom",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nomnom-db",
      "database_id": "nomnom-local-db",
      "migrations_dir": "migrations"
    }
  ]
}